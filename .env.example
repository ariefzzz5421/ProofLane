DATABASE_URL=file:local.db
# Required for Turso/Vercel: libsql://... and DATABASE_AUTH_TOKEN=...
DATABASE_AUTH_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# RPC URLs are server-only. Configure one per supported chain.
RPC_URL_1=
RPC_URL_8453=
# Optional Discord OAuth membership verification
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Optional seed admin; never expose these to the client
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional cron secret for queued webhook retries
CRON_SECRET=
# 64 hex characters for AES-256-GCM encryption of webhook signing secrets
WEBHOOK_ENCRYPTION_KEY=
